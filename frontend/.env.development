# API and WebSocket calls go to the dev server's own origin; the proxy in vite.config.ts forwards them
# to the local services, or to the deployed environment when DEV_PROXY_TARGET is set, e.g. in
# .env.development.local (git-ignored):  DEV_PROXY_TARGET=https://<id>.cloudfront.net
# Cognito: authority = https://cognito-idp.<region>.amazonaws.com/<userPoolId>; scope = <resource-server>/<scope>
VITE_OIDC_AUTHORITY=https://cognito-idp.us-east-2.amazonaws.com/us-east-2_TaQOwpmkA
VITE_OIDC_CLIENT_ID=17687au1t7n5f4sou3krgjbjak
VITE_OIDC_SCOPE=ordermanager/market.read
